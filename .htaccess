RewriteEngine On

# DirectoryIndex configuration
DirectoryIndex index.php public/index.php

# Block direct access to internal directories
RewriteRule ^(views|app|config|database|scratch|storage)/ - [F,L]
RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json) - [F,L]

# Directly serve uploads and assets from public folder
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# If the request is not for an existing file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Route everything to public/index.php
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]

# ==========================================
# PERFORMANCE OPTIMIZATIONS (GZIP & CACHING)
# ==========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml font/woff2 font/woff
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
